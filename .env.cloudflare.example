# Cloudflare build-time environment (copy to .env.cloudflare or export in CI)
# These values are inlined into the client bundle at build time.

NEXT_PUBLIC_SITE_URL="https://academy.emyphilltech.com.ng"
NEXT_PUBLIC_SITE_NAME="Brave Skill"
NEXT_PUBLIC_SUPPORT_EMAIL="support@academy.emyphilltech.com.ng"
NEXT_PUBLIC_SUPPORT_PHONE="+234 800 000 0000"
NEXT_PUBLIC_WHATSAPP="2348000000000"

# Use a direct (pooled) Postgres URL for `prisma migrate deploy` from CI.
# At runtime, put the Hyperdrive connection string in a Worker secret instead:
#   npx wrangler secret put DATABASE_URL
DATABASE_URL="postgresql://user:password@host:5432/braveskill?sslmode=require"
