# ─── Brave Skill — local environment ─────────────────────────────────────────
# Copy this file to .env and replace every placeholder before deploying.

DATABASE_URL="postgresql://a@localhost:5432/braveskill?schema=public"

# 32+ random bytes. Generate: openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-4f8b0f0c1d2e3a4b5c6d7e8f9a0b1c2d"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Brave Skill"
NEXT_PUBLIC_SUPPORT_EMAIL="support@academy.emyphilltech.com.ng"
NEXT_PUBLIC_SUPPORT_PHONE="+234 800 000 0000"
NEXT_PUBLIC_WHATSAPP="2348000000000"

# ─── Paystack ────────────────────────────────────────────────────────────────
# Leave blank to run the platform's built-in test checkout (never enable in production).
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# Only honoured when both Paystack keys are blank. Set false before launch.
ALLOW_DEMO_PAYMENTS="true"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Private directory for videos, PDFs and APKs. Served only through authorised
# /api/media routes. In production point this at an encrypted volume or mount.
STORAGE_DIR="./storage"

# ─── Email (optional) ────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Brave Skill <no-reply@academy.emyphilltech.com.ng>"

# ─── Ops ─────────────────────────────────────────────────────────────────────
# Comma separated emails that receive admin alerts (optional)
ADMIN_ALERT_EMAILS=""
BACKUP_DIR="./backups"
