{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brave-skill",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "CF_WORKER": "1",
    "NEXT_PUBLIC_SITE_NAME": "Brave Skill",
    "NEXT_PUBLIC_SITE_URL": "https://academy.emyphilltech.com.ng",
    "NEXT_PUBLIC_SUPPORT_EMAIL": "support@academy.emyphilltech.com.ng",
    "NEXT_PUBLIC_SUPPORT_PHONE": "+234 800 000 0000",
    "NEXT_PUBLIC_WHATSAPP": "2348000000000",
    "R2_BUCKET": "brave-skill-media",
    "R2_REGION": "auto",
    "RESEND_FROM": "Brave Skill <no-reply@academy.emyphilltech.com.ng>"
  },
  "routes": [
    {
      "pattern": "academy.emyphilltech.com.ng",
      "custom_domain": true
    }
  ]
}
